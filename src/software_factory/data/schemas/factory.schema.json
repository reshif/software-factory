{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "profile",
    "completion_target",
    "work_types",
    "limits",
    "checks",
    "owners",
    "delivery",
    "evidence_exclude"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/definitions/profile"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/profile"
          }
        }
      ]
    },
    "completion_target": {
      "enum": [
        "READY_PR",
        "DELIVERED"
      ]
    },
    "work_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "feature",
          "patch",
          "maintenance"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_attempts",
        "parallel_writers",
        "check_timeout_seconds"
      ],
      "properties": {
        "repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "parallel_writers": {
          "const": 1
        },
        "check_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "check_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "high_risk_lines": {
          "description": "Changed-line count (excluding test paths and lockfiles) above which mission risk is high (default 400).",
          "type": "integer",
          "minimum": 50,
          "default": 400
        },
        "stale_hours": {
          "description": "Hours without a record change after which mission list and doctor call an open mission stale (default 24).",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "cwd",
          "required",
          "timeout_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "command": {
            "$ref": "#/definitions/command"
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "output_limit_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 67108864
          },
          "env": {
            "$ref": "#/definitions/env"
          }
        }
      }
    },
    "check_env": {
      "description": "How checks and setup steps receive the factory's environment. `inherit` (default) passes it minus TYPESAFE_API_KEY; `allowlist` passes only PATH, HOME, LANG, LC_*, TERM, TMPDIR, TEMP, TMP and VIRTUAL_ENV (plus SYSTEMROOT, COMSPEC and PATHEXT on Windows) and the names a check lists in `env`. A check with `env` always uses the allowlist.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "inherit",
            "allowlist"
          ],
          "default": "inherit"
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintainer",
        "reviewer"
      ],
      "properties": {
        "maintainer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "staging_command",
        "release_command",
        "recovery_command"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "staging_command": {
          "anyOf": [
            {
              "$ref": "#/definitions/command"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_command": {
          "anyOf": [
            {
              "$ref": "#/definitions/command"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_command": {
          "anyOf": [
            {
              "$ref": "#/definitions/command"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "model_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "inherit",
            "recommend",
            "required",
            "roles"
          ]
        },
        "roles": {
          "description": "With mode `roles`: the model each role uses, per client (`claude` accepts aliases such as opus, sonnet, haiku, fable or a full model ID; `codex` and `copilot` take the client's model name). A missing role or client, or `inherit`, uses the session's model.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orchestrator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "planner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "implementer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "verifier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                }
              }
            },
            "codex": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orchestrator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "planner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "implementer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "verifier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                }
              }
            },
            "copilot": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "orchestrator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()-]*$"
                },
                "planner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()-]*$"
                },
                "implementer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()-]*$"
                },
                "verifier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()-]*$"
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/()-]*$"
                }
              }
            }
          }
        },
        "confirmed_sha256": {
          "description": "Hash of the role map the user approved through a setup proposal; a map that differs from it is unconfirmed.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "description": "How specialists get their models. `roles` (the default for new projects) pins a model per role in each client's agent files, so the client enforces it; `inherit` uses the session's model; `recommend`/`required` plan models per task with `software-factory models plan`."
    },
    "approvals": {
      "description": "How the user's own scope, exception, merge and release approvals are recorded. `mission approve` in an interactive terminal always works; agents can never record these decisions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat": {
          "description": "With the claude profile, install a UserPromptSubmit hook in .claude/settings.json that records the approval when the user's own chat message reads `approve <MISSION-ID> <scope|exception|merge|release>`. Set false to require the terminal command.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "enforcement": {
      "description": "Client enforcement of the orchestrator role, on by default. Local guardrail only; live behaviour is not verified by the factory.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude_orchestrator_agent": {
          "description": "With the claude profile: a PreToolUse guard in .claude/settings.json checks every main-session tool call in this project (specialists' calls pass through), and .claude/agents/factory-orchestrator.md adds a tool allowlist when started with claude --agent factory-orchestrator. Set false to turn both off.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "evidence_exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "cwd",
          "timeout_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "command": {
            "$ref": "#/definitions/command"
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "output_limit_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 67108864
          },
          "env": {
            "$ref": "#/definitions/env"
          }
        }
      }
    },
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "provider",
        "model"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "const": "typesafe"
        },
        "model": {
          "type": "string",
          "pattern": "^jev-[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "max_pairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 24576
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "max_source_age_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "cache": {
          "type": "boolean"
        },
        "cache_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "claim_mode": {
          "enum": [
            "shadow",
            "advisory"
          ]
        },
        "min_confidence": {
          "description": "Model routing: a JEV choice below this confidence leaves the assignment unresolved (default 0.6).",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        },
        "claim_accept_confidence": {
          "description": "Semantic claim checks: minimum JEV confidence to accept a claim judgment (default 0.8). Does not affect model plans.",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "triage_accept_confidence": {
          "description": "Check triage: minimum JEV confidence to classify a failed check; lower confidence or abstain leaves it unclassified for a human (default 0.6). Advisory only.",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        }
      }
    },
    "notify": {
      "description": "Best-effort notification when a mission becomes BLOCKED or the factory is halted: an argv command (no shell) run with SF_EVENT, SF_MISSION, SF_STATE and SF_REASON set.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "ci": {
      "description": "How a recorded CI success is checked. none (default): the URL and conclusion are recorded as given. gh: the GitHub CLI must confirm the GitHub Actions run completed successfully for the candidate commit, and MERGED requires that verification.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify": {
          "enum": [
            "none",
            "gh"
          ],
          "default": "none"
        }
      }
    },
    "crew": {
      "description": "Project knowledge (Learning with consent). enabled: freeze saved knowledge into new missions and their briefs (default true). personal: include the user's personal profile in planner briefs (default true; set false for shared team repositories). options: \"feature\" (default) requires graded options before scope approval for every kind but patch; \"off\" drops that requirement except for requests from a contributor or an anonymous author.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "personal": {
          "type": "boolean"
        },
        "options": {
          "enum": [
            "feature",
            "off"
          ]
        }
      }
    }
  },
  "definitions": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "env": {
      "description": "Environment variable names (never values) passed to this check in addition to the safe base; implies the allowlist mode. TYPESAFE_API_KEY is never passed and may not be listed.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "not": {
          "pattern": "^[Tt][Yy][Pp][Ee][Ss][Aa][Ff][Ee]_[Aa][Pp][Ii]_[Kk][Ee][Yy]$"
        }
      }
    },
    "profile": {
      "enum": [
        "claude",
        "codex",
        "copilot"
      ]
    }
  }
}
