{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optional local model calibration metadata",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "id",
        "mission_id",
        "task_id",
        "task_class",
        "comparison",
        "measurements",
        "provenance",
        "observed_at",
        "execution_context"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "outcome-input"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "mission_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "task_class": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_hash",
            "tools_hash",
            "acceptance_hash"
          ],
          "properties": {
            "prompt_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tools_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acceptance_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted",
            "wall_time_ms",
            "missed_defects",
            "usage"
          ],
          "properties": {
            "accepted": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wall_time_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "missed_defects": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "usage": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "amount"
                  ],
                  "properties": {
                    "unit": {
                      "enum": [
                        "tokens",
                        "credits",
                        "requests"
                      ]
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "enum": [
                "runtime",
                "user_report",
                "self_report",
                "unknown"
              ]
            },
            "reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "observed_at": {
          "type": "string"
        },
        "execution_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client_version",
            "reference"
          ],
          "properties": {
            "client_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "id",
        "mission_id",
        "task_id",
        "task_class",
        "comparison",
        "measurements",
        "provenance",
        "observed_at",
        "recorded_at",
        "result",
        "content_hash",
        "execution_context"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "outcome"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "mission_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "task_class": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_hash",
            "tools_hash",
            "acceptance_hash"
          ],
          "properties": {
            "prompt_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tools_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acceptance_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted",
            "wall_time_ms",
            "missed_defects",
            "usage"
          ],
          "properties": {
            "accepted": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wall_time_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "missed_defects": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "usage": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "amount"
                  ],
                  "properties": {
                    "unit": {
                      "enum": [
                        "tokens",
                        "credits",
                        "requests"
                      ]
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "enum": [
                "runtime",
                "user_report",
                "self_report",
                "unknown"
              ]
            },
            "reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "observed_at": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "fingerprint",
            "status",
            "attempt",
            "observed_model",
            "observed_effort",
            "identity_provenance",
            "identity_reference",
            "profile",
            "harness",
            "catalog_client_version",
            "billing_context"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "status": {
              "enum": [
                "complete",
                "blocked",
                "needs_review"
              ]
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "observed_model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_effort": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "identity_provenance": {
              "enum": [
                "runtime",
                "user_report",
                "self_report",
                "unknown"
              ]
            },
            "identity_reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "profile": {
              "anyOf": [
                {
                  "enum": [
                    "codex",
                    "claude",
                    "copilot"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "harness": {
              "anyOf": [
                {
                  "enum": [
                    "codex-native",
                    "claude-code-native",
                    "copilot-local",
                    "copilot-agent-host"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "billing_context": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "catalog_client_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client_version",
            "reference"
          ],
          "properties": {
            "client_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  ]
}
