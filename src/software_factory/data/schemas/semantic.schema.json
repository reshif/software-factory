{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explicitly supplied claim/source assessment input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "purpose",
    "sources",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "const": "claim_support"
    },
    "purpose": {
      "enum": [
        "model_research",
        "planning_research",
        "review_preparation"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reference",
          "locator",
          "retrieved_at",
          "excerpt",
          "sha256",
          "context_complete"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24000,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "context_complete": {
            "type": "boolean"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
