{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/approval-record.schema.json",
  "title": "Approval record (single-use)",
  "type": "object",
  "required": ["schema_version", "request_id", "gate", "mission_ids", "operation", "nonce",
               "state_version", "content_hash", "policy_version", "required_approvals",
               "decisions", "expires", "consumed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^REQ-" },
    "gate": { "enum": ["H1", "HM", "H2", "HX"] },
    "mission_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "operation": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["start_mission", "merge", "deploy", "exception"] },
        "target": { "type": "string" },
        "artifact": { "type": "string", "pattern": "^sha256:" },
        "config": { "type": "string" }
      }
    },
    "nonce": { "type": "string", "minLength": 16 },
    "state_version": { "type": "integer", "minimum": 0 },
    "content_hash": { "type": "string", "pattern": "^sha256:" },
    "policy_version": { "type": "string" },
    "required_approvals": {
      "type": "object",
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 3 },
        "security": { "type": "boolean" }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approver", "role", "decision", "decided_at"],
        "properties": {
          "approver": { "type": "string", "pattern": "^@" },
          "role": { "type": "string" },
          "decision": { "enum": ["approve", "revise", "defer", "cancel"] },
          "decided_at": { "type": "string", "format": "date-time" },
          "signature": { "type": "string" }
        }
      }
    },
    "expires": { "type": "string", "format": "date-time" },
    "consumed": {
      "type": "object",
      "required": ["at", "by", "fencing_token"],
      "properties": {
        "at": { "type": ["string", "null"] },
        "by": { "type": ["string", "null"] },
        "fencing_token": { "type": ["integer", "null"] }
      }
    }
  }
}
