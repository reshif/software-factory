# Every environment variable `factory-controller/src/factory/config.py`'s `Settings`
# reads (as `FACTORY_<FIELD_NAME_UPPER>`). Copy this to `.env`, fill in real values,
# and never commit `.env`.
#
# This file holds ONLY `FACTORY_*` Settings values -- `docker-compose.yml` also
# `env_file: [.env]`s this straight into the controller/worker containers, so it
# must never carry a secret that isn't a `Settings` field. The Postgres/LiteLLM
# passwords, the Anthropic API key and the two GitHub App private keys are
# Compose `secrets:` (plain files under `deploy/secrets/`, gitignored), not
# environment variables at all (red-team #2 item 8) -- see `docker-compose.yml`'s
# top comment and `deploy/secrets/README.md`.
#
# `factory demo`/tests never read this file -- `local` mode wires every port to
# a `Fake...` adapter regardless of what's in the environment (`wiring.py`).

# ── Mode ─────────────────────────────────────────────────────────────────────────
# local (every port on a Fake adapter; used by `factory demo` and tests) | production
FACTORY_MODE=production

# ── State store (B1) ─────────────────────────────────────────────────────────────
# postgresql://user:pass@host:5432/db . Unset -> in-memory (never use that in
# production). In docker-compose.yml this is built at container startup from the
# `postgres_password` secret (see entrypoint.sh) -- leave it unset here.
FACTORY_DATABASE_URL=

# ── Kit + products (B6, pipeline.products) ───────────────────────────────────────
# Defaults to ../factory-kit relative to this package if unset.
FACTORY_KIT_DIR=/var/lib/factory/kit
# Directory of <product>/factory.yaml (+ mandates/*.yaml). Required in production.
FACTORY_PRODUCTS_DIR=/var/lib/factory/products

# ── Approval inbox (B4) ───────────────────────────────────────────────────────────
# The base URL approvers' signed links point at (your controller's public URL).
FACTORY_INBOX_BASE_URL=https://factory.example.com
# HMAC key signing/verifying inbox and Slack tokens. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Required in production.
FACTORY_INBOX_SIGNING_KEY=

# ── GitHub (B2): two SEPARATE App identities (push bot / merge bot, final draft §11) ─
FACTORY_GITHUB_API_URL=https://api.github.com
# Shared secret configured on the GitHub App's webhook; verifies X-Hub-Signature-256.
FACTORY_GITHUB_WEBHOOK_SECRET=
FACTORY_PUSH_APP_ID=
# In docker-compose.yml this is the `push_app_private_key` secret's mount path
# (/run/secrets/push_app_private_key); set it to a real path only outside compose.
FACTORY_PUSH_APP_PRIVATE_KEY_PATH=
FACTORY_PUSH_APP_INSTALLATION_ID=
FACTORY_MERGE_APP_ID=
FACTORY_MERGE_APP_PRIVATE_KEY_PATH=
FACTORY_MERGE_APP_INSTALLATION_ID=

# ── Runtime (B3): Claude Agent SDK ────────────────────────────────────────────────
# Path to the `claude` CLI. ClaudeRuntime FAILS CLOSED without one -- it can't
# apply the environment-scrubbing wrapper that keeps agent subprocesses from
# inheriting this process's secrets. Baked into deploy/controller.Dockerfile.
FACTORY_CLAUDE_CLI_PATH=/usr/bin/claude

# ── Budget gateway (B3): LiteLLM, one virtual key per mission ────────────────────
FACTORY_LLM_GATEWAY_URL=http://litellm:4000
# The LiteLLM proxy's admin master_key (deploy/litellm/config.yaml). Never logged.
# (This one has no Settings-independent secret-file path yet; keep it out of
# version control the same way as every other value in your real `.env`.)
FACTORY_LLM_GATEWAY_MASTER_KEY=

# ── Slack (B4) ────────────────────────────────────────────────────────────────────
# Channel-wide FYI only (no token, no per-approver link). Optional.
FACTORY_SLACK_WEBHOOK_URL=
# chat.postMessage bot token: DMs each approver their own signed link. Required
# for DMs; without it the controller falls back to a logging notifier. Approvers
# also need a `slack_ids` entry in their product's factory.yaml to receive one.
FACTORY_SLACK_BOT_TOKEN=
# Verifies Slack's v0 request signature on the (future) interactive endpoint.
FACTORY_SLACK_SIGNING_SECRET=

# ── Sandbox (B3): DockerSandbox, network off by default ─────────────────────────
FACTORY_SANDBOX_IMAGE=factory-sandbox:latest
FACTORY_SANDBOX_ROOT=/var/lib/factory/sandboxes
# Only reachable when a task legitimately needs egress (dependency installs).
FACTORY_EGRESS_PROXY_URL=http://egress-proxy:8888
# Local git mirrors `GitMirror`/`SandboxPort.create` clone task checkouts from.
FACTORY_REPOS_ROOT=/var/lib/factory/repos

# ── Release (B5): CommandDeployTarget's 5 named hooks ────────────────────────────
# Each hook is a shell command receiving FACTORY_DEPLOY_{ARTIFACT,ENVIRONMENT,
# OPERATION_ID,TO_ARTIFACT} as env vars (release/deploy.py). All 5 are required in
# production -- wiring.py fails fast at startup listing whichever are missing.
FACTORY_DEPLOY_BUILD_CMD=
FACTORY_DEPLOY_CMD=
FACTORY_DEPLOY_HEALTH_CMD=
FACTORY_DEPLOY_ROLLBACK_CMD=
FACTORY_DEPLOY_URL_CMD=
# Where CommandDeployTarget persists its fencing high-water marks across restarts.
FACTORY_DEPLOY_STATE_DIR=/var/lib/factory/deploy-state

# ── Holdouts (B5): WorkflowHoldoutRunner's OWN read-only identity (§13.1 #4) ─────
# A fine-grained PAT (or a dedicated GitHub App installation token) scoped to
# read-only access on the holdout repo(s) ONLY -- never the push/merge bot's.
# Required only for products whose verification.required names holdout_blackbox;
# wiring.py fails fast at startup if one needs it and this is unset.
FACTORY_HOLDOUT_TOKEN=
FACTORY_HOLDOUT_WORKFLOW=holdout.yml

FACTORY_EVIDENCE_DIR=/var/lib/factory/evidence
