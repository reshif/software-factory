{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapters",
    "roles",
    "skills",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapters": {
      "const": [
        "claude",
        "codex",
        "copilot"
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "capability",
          "skill"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 48,
            "not": {
              "const": "orchestrator"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "capability": {
            "enum": [
              "read",
              "verify",
              "write"
            ]
          },
          "skill": {
            "type": "string",
            "pattern": "^factory-[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          }
        }
      },
      "$comment": "Exactly the four specialists (planner, implementer, verifier, reviewer); see the top-level $comment."
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^factory-[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "$comment": "At least the four role skills; the shipped registry lists twelve."
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^factory-[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "$comment": "At least factory-build, factory-blueprint, factory-resume and factory-status, which the rendered instructions name."
    }
  },
  "$comment": "Cross-list rules a schema cannot express are enforced by rendering._check_registry: names are unique across factory-<role>, skills and entries; roles are exactly the four specialists the orchestrator guard and allowlists name; each role's skill is listed; the entries include the four entry prompts the rendered instructions name."
}
