{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local factory verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "mission_id",
    "fingerprint",
    "post_fingerprint",
    "head",
    "base_commit",
    "spec_hash",
    "sequence",
    "started_at",
    "finished_at",
    "source_changed",
    "monitoring_uncertain",
    "monitoring_reasons",
    "fingerprint_format",
    "checks",
    "trust"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "mission_id": {
      "$ref": "#/definitions/id"
    },
    "fingerprint": {
      "$ref": "#/definitions/hash"
    },
    "fingerprint_format": { "const": "git-mode-v1" },
    "post_fingerprint": {
      "$ref": "#/definitions/hash"
    },
    "head": {
      "$ref": "#/definitions/commit"
    },
    "base_commit": {
      "$ref": "#/definitions/commit"
    },
    "spec_hash": {
      "$ref": "#/definitions/hash"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 20
    },
    "finished_at": {
      "type": "string",
      "minLength": 20
    },
    "source_changed": {
      "type": "boolean"
    },
    "trust": {
      "const": "local-unattested"
    },
    "model_assignments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "assignment_hash"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "assignment_hash": {
            "$ref": "#/definitions/hash"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "cwd",
          "required",
          "status",
          "exit_code",
          "signal",
          "duration_ms",
          "stdout_log",
          "stderr_log",
          "truncated"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "timeout",
              "error",
              "output_limit",
              "interrupted",
              "background_process"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "stdout_log": {
            "$ref": "#/definitions/log"
          },
          "stderr_log": {
            "$ref": "#/definitions/log"
          },
          "truncated": {
            "type": "boolean"
          },
          "resolved_program": {
            "description": "Absolute path the command's program resolved to on the check's PATH before it ran; null when it did not resolve.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "program_sha256": {
            "anyOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }]
          },
          "environment": {
            "description": "The check's environment mode and the variable names (never values) its process received, factory-set names included.",
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "names"],
            "properties": {
              "mode": { "enum": ["inherit", "allowlist"] },
              "names": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "$ref": "#/properties/checks/items"
      }
    },
    "monitoring_uncertain": {
      "type": "boolean"
    },
    "monitoring_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ignored_writes": {
      "description": "Git-ignored paths (directories end in /) the monitor saw written during checks, at most 200; reads are not observable.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ignored_writes_total": {
      "type": "integer",
      "minimum": 0
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "held_state",
        "resolution"
      ],
      "properties": {
        "held_state": {
          "enum": [
            "PAUSED",
            "BLOCKED"
          ]
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/hash"
        }
      }
    }
  }
}
