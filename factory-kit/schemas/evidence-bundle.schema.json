{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/evidence-bundle.schema.json",
  "title": "Evidence bundle",
  "type": "object",
  "required": ["schema_version", "mission_id", "revision", "content_hash", "diff_ref", "checks",
               "risk", "cost", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "mission_id": { "type": "string" },
    "task_ids": { "type": "array", "items": { "type": "string" } },
    "revision": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^sha256:" },
    "diff_ref": { "type": "string" },
    "checks": {
      "type": "object",
      "description": "Every required check must be present with conclusion 'success' (fail closed).",
      "additionalProperties": {
        "type": "object",
        "required": ["conclusion"],
        "properties": {
          "conclusion": { "enum": ["success", "failure", "skipped", "neutral", "cancelled", "timed_out", "missing"] },
          "detail": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "holdout": {
      "type": "object",
      "properties": { "passed": { "type": "integer" }, "total": { "type": "integer" } }
    },
    "risk": {
      "type": "object",
      "required": ["action_class", "rule_fired"],
      "properties": {
        "action_class": { "enum": ["AC1", "AC2", "AC3", "AC4", "AC5", "AC6", "AC7", "AC8"] },
        "rule_fired": { "type": "string" },
        "blast_radius": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rollback": {
      "type": "object",
      "properties": { "plan": { "type": "string" }, "tested": { "type": "boolean" } }
    },
    "cost": {
      "type": "object",
      "required": ["usd"],
      "properties": { "usd": { "type": "number" }, "tokens": { "type": "integer" }, "ci_minutes": { "type": "number" } }
    },
    "provenance": {
      "type": "object",
      "required": ["untrusted_inputs_read", "agent_versions"],
      "properties": {
        "untrusted_inputs_read": { "type": "array", "items": { "type": "string" } },
        "agent_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
