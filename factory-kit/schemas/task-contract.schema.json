{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/task-contract.schema.json",
  "title": "Task contract",
  "type": "object",
  "required": ["schema_version", "ids", "objective", "base_commit", "owned_paths", "action_class",
               "tools", "acceptance_checks", "limits"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "ids": {
      "type": "object",
      "required": ["mission", "task", "run"],
      "additionalProperties": false,
      "properties": {
        "mission": { "type": "string" },
        "task": { "type": "string" },
        "run": { "type": "string" },
        "depends_on": { "type": "array", "items": { "type": "string" } }
      }
    },
    "objective": { "type": "string", "minLength": 10 },
    "spec_revision": { "type": "string" },
    "base_commit": { "type": "string", "minLength": 7 },
    "owned_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "interfaces": { "type": "array", "items": { "type": "string" } },
    "action_class": { "enum": ["AC1", "AC2", "AC3", "AC4", "AC5", "AC6", "AC7"] },
    "tools": { "type": "array", "minItems": 1, "items": { "enum": ["read", "edit", "run_tests", "run_lint"] } },
    "acceptance_checks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "limits": {
      "type": "object",
      "required": ["repair_attempts", "infra_retries", "minutes", "usd"],
      "additionalProperties": false,
      "properties": {
        "repair_attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
        "infra_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 240 },
        "usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "max_diff_lines": { "type": "integer", "minimum": 1 }
  }
}
