{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/factory.schema.json",
  "title": "Product cell profile (factory.yaml)",
  "type": "object",
  "required": ["schema_version", "product", "risk_profile", "autonomy_level", "kit", "runtime",
               "models", "owners", "approvers", "lanes", "budgets", "repair_attempts", "verification"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "risk_profile": { "enum": ["experimental", "standard", "regulated"] },
    "autonomy_level": { "enum": ["L3", "L4", "L5"] },
    "kit": {
      "type": "object",
      "required": ["version", "policy_version"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^factory-kit@\\d+\\.\\d+\\.\\d+$" },
        "policy_version": { "type": "string" }
      }
    },
    "runtime": { "enum": ["claude", "codex"] },
    "models": {
      "type": "object",
      "required": ["triage", "build", "planning"],
      "additionalProperties": false,
      "properties": {
        "triage": { "type": "string" },
        "build": { "type": "string" },
        "planning": { "type": "string" }
      }
    },
    "owners": {
      "type": "object",
      "required": ["factory", "product", "tech_lead", "backup"],
      "additionalProperties": { "type": "string", "pattern": "^@" }
    },
    "approvers": {
      "type": "object",
      "required": ["h1", "hm", "h2", "hx"],
      "additionalProperties": false,
      "properties": {
        "h1": { "$ref": "#/$defs/approverList" },
        "hm": { "oneOf": [{ "const": "codeowners" }, { "$ref": "#/$defs/approverList" }] },
        "h2": { "$ref": "#/$defs/approverList" },
        "hx": { "$ref": "#/$defs/approverList" }
      }
    },
    "lanes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["patch", "feature", "incident", "spike", "fleet"] }
    },
    "protected_paths": { "$ref": "#/$defs/globList" },
    "forbidden_paths": { "$ref": "#/$defs/globList" },
    "gates": {
      "description": "Product overrides. May only tighten the gate table.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "enum": ["h1", "hm", "h2"] },
        "additionalProperties": { "type": "string" }
      }
    },
    "budgets": {
      "type": "object",
      "required": ["patch_task_usd", "feature_task_usd", "patch_mission_usd", "feature_mission_usd",
                   "monthly_usd", "reviewer_hours_per_week"],
      "additionalProperties": false,
      "properties": {
        "patch_task_usd": { "type": "number", "exclusiveMinimum": 0 },
        "feature_task_usd": { "type": "number", "exclusiveMinimum": 0 },
        "patch_mission_usd": { "type": "number", "exclusiveMinimum": 0 },
        "feature_mission_usd": { "type": "number", "exclusiveMinimum": 0 },
        "monthly_usd": { "type": "number", "exclusiveMinimum": 0 },
        "reviewer_hours_per_week": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "repair_attempts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 10 }
    },
    "infra_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
    "verification": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "mutation": { "enum": ["off", "diff_scoped", "full"] }
      }
    },
    "checks": {
      "description": "Check name -> command run in the sandbox with NO network. Every name in verification.required except review_agent and holdout_blackbox must appear here.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "holdout_repo": { "type": "string" },
    "observation_window": { "type": "string", "pattern": "^\\d+[hd]$" },
    "standing_mandates": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "approverList": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^@" } },
    "globList": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
