{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/mandate.schema.json",
  "title": "Mandate (mission or standing)",
  "type": "object",
  "required": ["schema_version", "mandate_id", "kind", "product", "budget", "kit_version",
               "policy_version", "expires", "approved_by", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "mandate_id": { "type": "string", "pattern": "^(MIS|SM)-[A-Za-z0-9-]+$" },
    "kind": { "enum": ["mission", "standing"] },
    "product": { "type": "string" },
    "outcome": { "type": "string" },
    "spec": {
      "type": "object",
      "required": ["ref", "revision"],
      "properties": { "ref": { "type": "string" }, "revision": { "type": "string" } }
    },
    "coverage": {
      "type": "object",
      "required": ["action_classes", "paths", "max_diff_lines"],
      "additionalProperties": false,
      "properties": {
        "labels_any": { "type": "array", "items": { "type": "string" } },
        "action_classes": {
          "type": "array", "minItems": 1,
          "items": { "enum": ["AC1", "AC2", "AC3"] }
        },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exclude_paths_from": { "type": "string" },
        "max_diff_lines": { "type": "integer", "minimum": 1, "maximum": 400 }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "repos": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "exclusiveMinimum": 0 },
        "per_mission_usd": { "type": "number", "exclusiveMinimum": 0 },
        "monthly_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_parallel_workers": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "merge_policy": { "type": "string" },
    "release_policy": { "type": "string" },
    "recovery": {
      "type": "object",
      "required": ["plan", "data_impact"],
      "properties": { "plan": { "type": "string" }, "data_impact": { "type": "string" } }
    },
    "kit_version": { "type": "string", "pattern": "^factory-kit@\\d+\\.\\d+\\.\\d+$" },
    "policy_version": { "type": "string" },
    "expires": { "type": "string", "format": "date" },
    "approved_by": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^@" } },
    "content_hash": { "type": "string", "pattern": "^sha256:" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "standing" } } },
      "then": { "required": ["coverage"] }
    },
    {
      "if": { "properties": { "kind": { "const": "mission" } } },
      "then": { "required": ["outcome", "spec", "recovery"] }
    }
  ]
}
