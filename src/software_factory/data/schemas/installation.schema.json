{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Software factory installation baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "version",
    "payload_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "managed"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "managed": {
            "type": "boolean"
          }
        }
      }
    },
    "runtime": {
      "const": "python-uv"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uninstalled": {
      "type": "boolean"
    },
    "preserved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
