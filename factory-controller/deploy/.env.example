# Every environment variable `factory-controller/src/factory/config.py`'s `Settings`
# reads (as `FACTORY_<FIELD_NAME_UPPER>`), plus the handful `docker-compose.yml`
# itself needs. Copy this to `.env`, fill in real values, and never commit `.env`.
#
# `factory demo`/tests never read this file -- `local` mode wires every port to
# a `Fake...` adapter regardless of what's in the environment (`wiring.py`).

# ── Compose-only (not read by Settings) ─────────────────────────────────────────
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=

# ── Mode ─────────────────────────────────────────────────────────────────────────
# local (every port on a Fake adapter; used by `factory demo` and tests) | production
FACTORY_MODE=production

# ── State store (B1) ─────────────────────────────────────────────────────────────
# postgresql://user:pass@host:5432/db . Unset -> in-memory (never use that in production).
FACTORY_DATABASE_URL=postgresql://factory:${POSTGRES_PASSWORD}@postgres:5432/factory

# ── Kit + products (B6, pipeline.products) ───────────────────────────────────────
# Defaults to ../factory-kit relative to this package if unset.
FACTORY_KIT_DIR=/var/lib/factory/kit
# Directory of <product>/factory.yaml (+ mandates/*.yaml). Required in production.
FACTORY_PRODUCTS_DIR=/var/lib/factory/products

# ── Approval inbox (B4) ───────────────────────────────────────────────────────────
# The base URL approvers' signed links point at (your controller's public URL).
FACTORY_INBOX_BASE_URL=https://factory.example.com
# HMAC key signing/verifying inbox and Slack tokens. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Required in production.
FACTORY_INBOX_SIGNING_KEY=

# ── GitHub (B2): two SEPARATE App identities (push bot / merge bot, final draft §11) ─
FACTORY_GITHUB_API_URL=https://api.github.com
# Shared secret configured on the GitHub App's webhook; verifies X-Hub-Signature-256.
FACTORY_GITHUB_WEBHOOK_SECRET=
FACTORY_PUSH_APP_ID=
FACTORY_PUSH_APP_PRIVATE_KEY_PATH=/run/secrets/push-app.pem
FACTORY_PUSH_APP_INSTALLATION_ID=
FACTORY_MERGE_APP_ID=
FACTORY_MERGE_APP_PRIVATE_KEY_PATH=/run/secrets/merge-app.pem
FACTORY_MERGE_APP_INSTALLATION_ID=

# ── Runtime (B3): Claude Agent SDK ────────────────────────────────────────────────
# Path to the `claude` CLI. ClaudeRuntime FAILS CLOSED without one -- it can't
# apply the environment-scrubbing wrapper that keeps agent subprocesses from
# inheriting this process's secrets. Baked into deploy/controller.Dockerfile.
FACTORY_CLAUDE_CLI_PATH=/usr/bin/claude

# ── Budget gateway (B3): LiteLLM, one virtual key per mission ────────────────────
FACTORY_LLM_GATEWAY_URL=http://litellm:4000
# The LiteLLM proxy's admin master_key (deploy/litellm/config.yaml). Never logged.
FACTORY_LLM_GATEWAY_MASTER_KEY=

# ── Slack (B4) ────────────────────────────────────────────────────────────────────
# Channel-wide FYI only (no token, no per-approver link). Optional.
FACTORY_SLACK_WEBHOOK_URL=
# chat.postMessage bot token: DMs each approver their own signed link. Required
# for DMs; without it (or without FACTORY_INBOX_SIGNING_KEY) the controller falls
# back to a logging notifier -- see README "Requests to orchestrator" re: the
# owners-to-Slack-id mapping `factory.yaml` doesn't have yet.
FACTORY_SLACK_BOT_TOKEN=
# Verifies Slack's v0 request signature on the (future) interactive endpoint.
FACTORY_SLACK_SIGNING_SECRET=

# ── Sandbox (B3): DockerSandbox, network off by default ─────────────────────────
FACTORY_SANDBOX_IMAGE=factory-sandbox:latest
FACTORY_SANDBOX_ROOT=/var/lib/factory/sandboxes
# Only reachable when a task legitimately needs egress (dependency installs).
FACTORY_EGRESS_PROXY_URL=http://egress-proxy:8888
# Local git mirrors DockerSandbox/LocalSandbox clone task checkouts from. A repo
# must already be mirrored here before its product can be sandboxed -- see
# README "Requests to orchestrator" (there is no `RepoMirror` port yet).
FACTORY_REPOS_ROOT=/var/lib/factory/repos

# ── Release (B5) ──────────────────────────────────────────────────────────────────
# A single shell hook is not enough for CommandDeployTarget, which needs 5 named
# commands (build/deploy/health/rollback/url) -- see README "Requests to
# orchestrator". Until Settings grows those fields, DeployTarget/HoldoutRunner
# are wired to a stub that fails closed (any release candidate simply won't pass).
FACTORY_DEPLOY_COMMAND=
FACTORY_EVIDENCE_DIR=/var/lib/factory/evidence
